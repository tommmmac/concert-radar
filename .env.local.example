VITE_TICKETMASTER_API_KEY=your_key_here
# Set to "true" to use local mock data instead of hitting the live API (saves rate limit while iterating on UI)
VITE_USE_MOCK_DATA=true

# Server-only (no VITE_ prefix — never sent to the browser). Used by
# api/spotify-artist.ts for the Client Credentials flow. Create an app at
# https://developer.spotify.com/dashboard to get these.
#
# NOTE: `vercel dev` (needed to test this locally) reads these from a
# plain `.env` file, not `.env.local` — copy this file to both, or just
# put everything in `.env`.
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
