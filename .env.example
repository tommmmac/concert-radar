VITE_TICKETMASTER_API_KEY=your_key_here
# Set to "true" to use local mock data instead of hitting the live API (saves rate limit while iterating on UI)
VITE_USE_MOCK_DATA=true

# Server-only (no VITE_ prefix — never sent to the browser). Used by
# api/spotify-artist.ts for the Client Credentials flow. Create an app at
# https://developer.spotify.com/dashboard to get these. Only needed if
# you're testing via `npx vercel dev` (plain `npm run dev` ignores these).
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Server-only Neon Postgres connection string, used by api/events.ts and
# `npm run ingest`. Copy it from the Vercel dashboard (Storage → Neon) —
# don't `vercel env pull .env`, which overwrites this file.
DATABASE_URL=

# Read-only, no secret needed — safe as a client-side VITE_ var, unlike
# Spotify above. Free key at https://www.last.fm/api/account/create.
# Powers the genre pills and artist bios on venue and News cards.
VITE_LASTFM_API_KEY=your_key_here
